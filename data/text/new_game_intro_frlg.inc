	.string "{JPN}{RIVAL} だったかな?$"

gOakSpeech_Text_RememberRivalsName::
	.string "{JPN}そうだ おもいだしたぞ!\n"
	.string "{RIVAL} という なまえだ!\p"
	.string "$"

gOakSpeech_Text_LetsGo::
	.string "{JPN}{PLAYER}!\p"
	.string "いよいよ これから\n"
	.string "きみの ものがたりの はじまりだ!\p"
	.string "ゆめと ぼうけんと!\n"
	.string "ポケット モンスターの せかいへ!\p"
	.string "レッツ ゴー!$"

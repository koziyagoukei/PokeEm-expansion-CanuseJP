	.string "あたしの ように\n"
	.string "いつまでも たたかって いくんだ!$"

gFameCheckerPersonName_Lance:: @ 0x81B097F
	.string "{JPN}{COLOR BLUE}{SHADOW LIGHT_BLUE}ワタル$"

gFameCheckerPersonQuote_Lance:: @ 0x81B098B
	.string "{JPN}{COLOR BLUE}{SHADOW LIGHT_BLUE}ワタル から\n"

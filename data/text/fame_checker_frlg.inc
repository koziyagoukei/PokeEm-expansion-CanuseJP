gFameCheckerPersonQuote_Sabrina:: @ 0x81B0675
	.string "{JPN}{COLOR BLUE}{SHADOW LIGHT_BLUE}ナツメ から\n"
	.string "{PLAYER}へ\p"
	.string "{FONT_FEMALE}{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}あなたの ポケモンへの あいじょう\p"

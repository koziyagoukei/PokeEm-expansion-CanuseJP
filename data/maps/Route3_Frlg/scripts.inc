Route3_Frlg_MapScripts::
	.byte 0

Route3_EventScript_Youngster::
	msgbox Route3_Text_TunnelFromCeruleanTiring, MSGBOX_NPC
	end

Route3_EventScript_RouteSign::
	msgbox Route3_Text_RouteSign, MSGBOX_SIGN
	end

Route3_Text_TunnelFromCeruleanTiring::
	.string "{JPN}ふう…\n"
	.string "この へんで…\l"
	.string "… ひとやすみ して いこう\p"
	.string "ハナダ シティから\n"
	.string "どうくつを ぬけて きたら\l"
	.string "… つかれた$"

Route3_Text_ColtonIntro::
	.string "{JPN}あッ おまえ!\n"
	.string "トキワの もりで みかけたぞ!$"

Route3_Text_ColtonDefeat::
	.string "{JPN}くやしいけど まけた$"

Route3_Text_ColtonPostBattle::
	.string "{JPN}この あたりは\n"
	.string "もり とは また ちがった\l"
	.string "ポケモンが とれるんだ!$"

Route3_Text_BenIntro::
	.string "{JPN}たんパン\n"
	.string "うごき やすくって いいぜ!\l"
	.string "おまえも はけば?$"

Route3_Text_BenDefeat::
	.string "{JPN}いけると おもったのに$"

Route3_Text_BenPostBattle::
	.string "{JPN}ポケモンセンターの パソコン\n"
	.string "きみ つかってる?\p"
	.string "1つの ボックスに ポケモンを\n"
	.string "30ぴき まで あずけられるよ$"

Route3_Text_JaniceIntro::
	.string "{JPN}ちょっと きみ!\n"
	.string "いま わたしの ほう みたでしょ$"

Route3_Text_JaniceDefeat::
	.string "{JPN}もう いや$"

Route3_Text_JanicePostBattle::
	.string "{JPN}じろじろ みるから\n"
	.string "たたかう ことに なるのよ!$"

Route3_Text_GregIntro::
	.string "{JPN}きみ ポケモン トレーナー?\n"
	.string "じゃ さっそく!$"

Route3_Text_GregDefeat::
	.string "{JPN}あたらしい ポケモン\n"
	.string "もって くれば かてたよ$"

Route3_Text_GregPostBattle::
	.string "{JPN}パソコンで ポケモン あずける\n"
	.string "ボックスが いっぱいに なったら\l"
	.string "ほかの ボックスに\l"
	.string "きりかえれば いいんだよ$"

Route3_Text_SallyIntro::
	.string "{JPN}きみの しせん!\n"
	.string "… なーんか きに なる!$"

Route3_Text_SallyDefeat::
	.string "{JPN}もっと やさしく\n"
	.string "しょうぶ できない?$"

Route3_Text_SallyPostBattle::
	.string "{JPN}もし たたかいたく なかったら\n"
	.string "しせんを あわせなければ いいの$"

Route3_Text_CalvinIntro::
	.string "{JPN}なんだよ! おまえは\n"
	.string "たんパン はいて ないじゃん$"

Route3_Text_CalvinDefeat::
	.string "{JPN}まけたまけた$"

Route3_Text_CalvinPostBattle::
	.string "{JPN}なつも ふゆも\n"
	.string "たんパン しか はかない!\l"
	.string "それが おれの ポリシー$"

Route3_Text_JamesIntro::
	.string "{JPN}とって きた ばかりの ポケモン\n"
	.string "たたかわせよう かな!$"

Route3_Text_JamesDefeat::
	.string "{JPN}ぼろまけだ$"

Route3_Text_JamesPostBattle::
	.string "{JPN}やっぱり… そだてた\n"
	.string "ポケモンの ほうが つよいんだな$"

Route3_Text_RobinIntro::
	.string "{JPN}… きゃ!\n"
	.string "いま あんた おさなかった?$"

Route3_Text_RobinDefeat::
	.string "{JPN}もう おわり?$"

Route3_Text_RobinPostBattle::
	.string "{JPN}オツキミやまの ふもと からは\n"
	.string "4ばん どうろよ$"

Route3_Text_RouteSign::
	.string "{JPN}ここは 3ばん どうろ\n"
	.string "… このさき オツキミやま$"

